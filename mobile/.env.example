# Expo public env vars (must be prefixed EXPO_PUBLIC_ to be available in the app).
# Use the SAME Supabase project as the web app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the deployed web app (used for deep links like checkout/booking
# that are not yet native). Defaults to the production site.
EXPO_PUBLIC_WEB_URL=https://safree.com
